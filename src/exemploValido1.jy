program: ExemploSomaMedia;

decIDs:
    nome : str;

float media (float a, float b, float c){
    decIds:
        m : float;
    m = (a + b + c) / 3;
    return m;
}

main:
    decIds:
        x, y, z : float;
        resultado : float;

    print("Digite três números:");
    input(x, y, z);

    resultado = media(x, y, z);

    print("A média é:", resultado);

end
