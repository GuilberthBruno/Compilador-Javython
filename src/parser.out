Rule 5     vars_declarations -> var_declaration
Rule 6     vars_declarations -> var_declaration vars_declarations
Rule 7     var_declaration -> ID COLON type SEMICOLON
Rule 8     type -> INT
Rule 9     type -> FLOAT
Rule 10    empty -> <empty>
Rule 11    statements -> statement_list
Rule 12    statement_list -> statement
