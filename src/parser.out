Rule 22    print_statement -> PRINT LPAREN expression RPAREN SEMICOLON
Rule 23    input_statement -> INPUT LPAREN ID RPAREN SEMICOLON
Rule 24    block_statement -> LBRACE statements RBRACE
Rule 25    block_statement -> LBRACE RBRACE
Rule 26    assignment -> ID ASSIGN expression
Rule 27    assignment -> ID INCREMENT
Rule 28    assignment -> ID DECREMENT
Rule 29    if_statement -> IF LPAREN condition RPAREN statement
Rule 30    if_statement -> IF LPAREN condition RPAREN statement ELSE statement
Rule 31    while_statement -> WHILE LPAREN condition RPAREN statement
Rule 32    for_statement -> FOR LPAREN assignment COLON condition COLON assignment RPAREN statement
Rule 33    condition -> expression comparison expression
Rule 34    condition -> NOT condition
Rule 35    comparison -> EQUALS
Rule 36    comparison -> NEQUALS
Rule 37    comparison -> GT
Rule 38    comparison -> LT
Rule 39    expression -> term
Rule 40    expression -> expression PLUS term
Rule 41    expression -> expression MINUS term
Rule 42    term -> factor
Rule 43    term -> term TIMES factor
Rule 44    term -> term DIVIDE factor
Rule 45    factor -> ID
Rule 46    factor -> NUMBER
Rule 47    factor -> LPAREN expression RPAREN
Rule 48    factor -> MINUS factor

