program: TesteBooleano;

bool maiorQue10(int n){
    decIds:
        resultado : bool;

    if (n > 10) {
        resultado = true;
    } else {
        resultado = false;
    }
    return resultado;
}

main:
    decIds:
        numero : int;
        condicao : bool;

    print ("Digite um número:");
    input(numero);

    condicao = maiorQue10(numero);

    if (condicao) {
        print ("Maior que 10");
    } else {
        print ("Menor ou igual a 10");
    }

end